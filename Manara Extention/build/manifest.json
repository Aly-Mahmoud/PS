{
  "name": "Manara Chrome",
  "description": "An extension to track Manara progress on Leetcode Problems",
  "version": "1.0",
  "manifest_version": 3,
  "host_permissions": [
    "*://*.leetcode.com/"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Open the popup"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "./static/content/content.js"
      ]
    }
  ],
  "icons": {
    "16": "logo192.png",
    "48": "logo192.png",
    "128": "logo192.png"
  }
}