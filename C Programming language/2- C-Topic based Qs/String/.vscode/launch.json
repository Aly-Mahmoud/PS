{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug with GDB",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/thirtyfive.exe", // Replace with your compiled output
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": true, // Use external console
        "MIMode": "gdb",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "miDebuggerPath": "C:/MinGW/bin/gdb.exe", // Update to your GDB path
        "preLaunchTask": "build"
      }
    ]
  }
  